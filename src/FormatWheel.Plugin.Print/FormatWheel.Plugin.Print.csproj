<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>FormatWheel.PrintPlugin</RootNamespace>
    <AssemblyName>FormatWheel.Print</AssemblyName>
    <Version>1.0.3</Version>
    <Title>Format Wheel · печать</Title>
    <Description>Пример расширения Format Wheel: отправка файлов на печать из третьего меню колеса (Alt + Shift). 10 функций + автообновление с GitHub.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../FormatWheel.Sdk/FormatWheel.Sdk.csproj" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

</Project>
